// Spyro recompiler seeds — the GAME half of psxport's function discovery (emit.py --seeds).
//
// emit.py seeds from the binary itself (the PS-EXE entry point + the pointer/table scans) and grows
// the set by following direct `jal` targets. This file adds only what those scans CANNOT see:
// functions reached solely through a function pointer, and runtime-computed re-entry points.
//
// It is deliberately near-empty. Spyro is a single executable with no code overlays, and binary-only
// discovery already reaches 621 functions spanning [0x8001041C,0x80074A1C] — essentially the whole
// text (image text is [0x80010000,0x80075800)). Adding a seed we have not SEEN the substrate need
// would be guessing: a seed that lands mid-function splits a real function at an arbitrary offset
// and silently corrupts the recomp.
//
// GROW THIS FILE EMPIRICALLY. The substrate fails fast on an unrecompiled call:
//   [recomp-MISS] 0x800xxxxx
// When that happens, find how the address is reached (`tools/disasm.py`, the caller's `ra`), add it
// below WITH that rationale, and re-run ./run.sh. The rationale is the point — an address with no
// explanation is unreviewable a year from now.
//
// JSON with `//` line comments. Addresses are hex strings. Schema (all keys optional):
//   main, main_reentry, overlay_bases, overlay_base_patterns, overlay_seeds
// See external/psxport/docs/porting-a-new-psx-game.md.
{
  // No fn-pointer-only targets observed yet.
  "main": [
    // Reached only via a function pointer — direct-jal discovery cannot see it. Surfaced by the
    // fail-fast boot AFTER the OVL0 overlay was recompiled (the overlay's code path reaches it):
    //   [recomp-MISS] 0x80024054  caller ra=0x80078A58, a0=4, pc=0x80023AC4
    // Do NOT read that `ra` as a code address in an undiscovered overlay region — it is not one.
    // 0x80078A58 lies in .bss (8160 bytes below the arena base 0x8007AA38), nothing in the resident
    // text or in OVL0 jumps to it, and it is one of the most heavily referenced globals in the level
    // overlays (51-73 lui/addiu references each). It is a big engine struct, so the `ra` in that
    // diagnostic was not a return address. Chasing it as a second overlay region is a dead end.
    // It lies inside the resident text [0x80010000,0x80075800), so it is a resident function the
    // scans missed, not another overlay body.
    "0x80024054",

    // Case labels of a COMPUTED-OFFSET jump (C049, docs/issues/0020). At 0x8004C4D4/D8 a lui+addiu
    // materialises the base 0x8004C4EC, 0x8004C4B0/B4 builds idx<<4, 0x8004C4E0 adds them and
    // 0x8004C4E4 is `jr s2` — target = base + idx*16, a jump into an unrolled run of 16-byte blocks.
    // emit.py's find_jump_tables only recognises TABLE lookups (`lw rN,OFF(base)`), so it cannot see
    // this idiom and the jump routes to rec_dispatch and fail-fasts at runtime.
    //
    // These are seeded as functions AND listed in main_reentry, which is this recompiler's mechanism
    // for a mid-function entry: the seed makes the address dispatchable, and main_reentry makes the
    // PRECEDING body fall through into it rather than `return` (see emit_func's comment on
    // Tomba!2's 0x8010637C -> 0x801063F4). Seeding without the reentry entry would truncate the
    // preceding block; the pair is what makes it correct.
    "0x8004C4EC", "0x8004C4FC",
    "0x8004C550", "0x8004C560",
    "0x8004C5D0", "0x8004C5E0"
  ],

  // Runtime-computed mid-function re-entry points. None PROVEN yet — see docs/issues/0020.
  //
  // A fail-fast at 0x8004C4EC (reached once the first level overlay loaded) looked like a re-entry
  // case: 0x8004C4E4 is `add s2,s2,s1 ; jr s2`, a COMPUTED jump into GTE case bodies. Six case labels
  // were tried here and had NO effect, because the enclosing code is not a recompiled function at all —
  // and it has no ordinary entry either. 0x8004BE3C, which a `jr ra`-based entry scan reports as the
  // function start, is really `add s7,s7,s4 ; j 0x8004AF88`: more unrolled dispatch, not a prologue.
  // So the region 0x8004BE3C-0x8004C5F8 is one large computed-jump area that the recompiler's
  // discovery does not model, and neither "main" nor "main_reentry" is the right lever yet.
  //
  // Seeding a guessed entry here would split a real function at an arbitrary offset and silently
  // corrupt the recomp — the exact failure this file exists to prevent. Left EMPTY deliberately.
  "main_reentry": [
    // Case labels of a COMPUTED-OFFSET jump (C049): 0x8004C4D4/D8 materialise base 0x8004C4EC,
    // 0x8004C4B0/B4 build idx<<4, 0x8004C4E0 adds them and 0x8004C4E4 is `jr s2` — so the target is
    // base + idx*16. emit.py's find_jump_tables only recognises TABLE lookups (`lw rN,OFF(base)`), so
    // it cannot see this and the jump routes to rec_dispatch and fail-fasts.
    // These addresses lie INSIDE the recompiled gen_func_8004BE4C (its labels span
    // L_8004BF14..L_8004D4C4), which is exactly what this list is for: re-entry points within an
    // existing body, NOT new function entries.
    "0x8004C4EC", "0x8004C4FC",
    "0x8004C550", "0x8004C560",
    "0x8004C5D0", "0x8004C5E0"
  ],

  // Spyro's overlays are NOT separate disc files — they live inside WAD.WAD and are loaded into the
  // heap. Confirmed from the binary: four hardcoded jals call addresses above the resident text end
  // (docs/issues/0001). The public decomps describe 37 overlays; one is recompiled so far.
  //
  // 0x8007AA38 is NOT "OVL0's base" — it is a single shared staging ARENA that every overlay is
  // loaded into, sourced from the read-only constant [0x800113A0] (claim C032, tools/callsite_args.py).
  // OVL0 simply occupies it during boot. This is why THIS LIST CANNOT SIMPLY BE EXTENDED: a second
  // entry here would emit a second module at the same base and collide. See docs/issues/0013 — the
  // fix is a keying decision in the substrate, not another line in this file.
  //
  // OVL0 — WAD.WAD +0x5B800, 14336 bytes, loaded to the arena at 0x8007AA38. The base is VERIFIED,
  // not guessed: at it the region decodes 100% valid MIPS with a real-code opcode profile, and all
  // four of the executable's hardcoded out-of-text call targets (0x8007AA50 / 0x8007ABAC /
  // 0x8007BFD0 / 0x8007CEE4) land inside it on prologue shapes. A wrong overlay base emits a whole
  // module at wrong addresses, so this is exactly the value that must never be guessed.
  // OVL1 — WAD.WAD +0xB83800, 65536 bytes, loaded to the SAME arena base. This is WAD index entry 11,
  // one of the 36 code entries, and the first LEVEL overlay the port ever loads. Base is OBSERVED, not
  // inferred: with the streaming read primitive 0x80016698 served (C047), a run logs
  //   stream: a0=37 dest=0x8007AA38 len=65536 a3=0x00B83800 -> moved 65536 bytes
  // and the address that was fail-fasting, 0x8008772C, falls inside [0x8007AA38, 0x8008AA38).
  // Two overlays sharing one base is exactly what psxport's slot router handles — it tells them apart
  // by content signature, so this is a second tag at the same address, not a collision.
  "overlay_bases": { "OVL0": "0x8007AA38", "OVL1": "0x8007AA38" },
  "overlay_base_patterns": [],
  "overlay_seeds": {}
}
