# Build + generated artifacts (regenerated by run.sh / tools/ensure_recomp.py)
build/
scratch/
generated/

# The recompiled substrate's INPUTS are extracted from your own disc — never committed.
# Kept NARROW on purpose: the extracted executable and any disc-derived blobs land under scratch/,
# which is already ignored above. Broad patterns here (SCUS_*, *.exe, *.bin) would also match ordinary
# PROSE naming those files, which floods the publication audit's "docs referencing gitignored items"
# check with false positives — and a gate that cries wolf is one people stop reading.
*.chd
.env

# The framework submodule's own working-tree noise
external/psxport/build/
external/psxport/scratch/
*.log

# Python bytecode — never committed. Compiled .pyc embed ABSOLUTE SOURCE PATHS, i.e. a machine-path
# leak that a TEXT-only audit cannot see, because they are binary.
__pycache__/
*.pyc

# Editor/OS noise
.DS_Store
compile_commands.json
