// Spyro recompiler seeds — the GAME half of psxport's function discovery (emit.py --seeds).
//
// emit.py seeds from the binary itself (the PS-EXE entry point + the pointer/table scans) and grows
// the set by following direct `jal` targets. This file adds only what those scans CANNOT see:
// functions reached solely through a function pointer, and runtime-computed re-entry points.
//
// It is deliberately near-empty. Spyro is a single executable with no code overlays, and binary-only
// discovery already reaches 621 functions spanning [0x8001041C,0x80074A1C] — essentially the whole
// text (image text is [0x80010000,0x80075800)). Adding a seed we have not SEEN the substrate need
// would be guessing: a seed that lands mid-function splits a real function at an arbitrary offset
// and silently corrupts the recomp.
//
// GROW THIS FILE EMPIRICALLY. The substrate fails fast on an unrecompiled call:
//   [recomp-MISS] 0x800xxxxx
// When that happens, find how the address is reached (`tools/disasm.py`, the caller's `ra`), add it
// below WITH that rationale, and re-run ./run.sh. The rationale is the point — an address with no
// explanation is unreviewable a year from now.
//
// JSON with `//` line comments. Addresses are hex strings. Schema (all keys optional):
//   main, main_reentry, diagnostic_pcs, overlay_bases, overlay_base_patterns, overlay_seeds
// See external/psxport/docs/porting-a-new-psx-game.md.
// `main_reentry` is itself a resident discovery root and the fallthrough-boundary authority. Put a
// measured true re-entry there ONLY; duplicating it in `main` is obsolete and creates two owners.
{
  // No fn-pointer-only targets observed yet.
  "main": [
    "0x80024054"
  ],

  // Runtime-computed mid-function re-entry points. None PROVEN yet — see docs/issues/0020.
  //
  // A fail-fast at 0x8004C4EC (reached once the first level overlay loaded) looked like a re-entry
  // case: 0x8004C4E4 is `add s2,s2,s1 ; jr s2`, a COMPUTED jump into GTE case bodies. Six case labels
  // were tried here and had NO effect, because the enclosing code is not a recompiled function at all —
  // and it has no ordinary entry either. 0x8004BE3C, which a `jr ra`-based entry scan reports as the
  // function start, is really `add s7,s7,s4 ; j 0x8004AF88`: more unrolled dispatch, not a prologue.
  // So the region 0x8004BE3C-0x8004C5F8 is one large computed-jump area that the recompiler's
  // discovery does not model, and neither "main" nor "main_reentry" is the right lever yet.
  //
  // Seeding a guessed entry here would split a real function at an arbitrary offset and silently
  // corrupt the recomp — the exact failure this file exists to prevent. Left EMPTY deliberately.
  "main_reentry": [],

  // Ordinary-instruction checkpoints for the paired-actor local-OT oracle. These PCs also occur
  // in overlapping generated bodies, so owner qualification is required to observe each actual
  // continuation exactly once. Cross-fragment dispatch recovery promotes the continuation PCs
  // below to independently dispatchable fragments; qualify them by those fragment entries rather
  // than by the older containing-body partition.
  "diagnostic_pcs": [
    {"owner": "0x800240F8", "pc": "0x800257A0"},
    {"owner": "0x800240F8", "pc": "0x800258B0"},
    {"owner": "0x8004EBA8", "pc": "0x8004ED44"},
    {"owner": "0x8004EDA0", "pc": "0x8004EE84"},
    {"owner": "0x8004EDA0", "pc": "0x8004EF68"},
    {"owner": "0x8004EBA8", "pc": "0x8004EF78"},
    {"owner": "0x8001F158", "pc": "0x8001F4C8"},
    {"owner": "0x8001F158", "pc": "0x8001F710"},
    {"owner": "0x8001F158", "pc": "0x8001F744"},
    {"owner": "0x8001F798", "pc": "0x8001FA1C"},
    {"owner": "0x8001F798", "pc": "0x8001FA88"},
    {"owner": "0x8001F798", "pc": "0x8001FAC4"},
    {"owner": "0x8001F798", "pc": "0x8001FB30"},
    {"owner": "0x8001F798", "pc": "0x8001FB84"},
    {"owner": "0x8001F798", "pc": "0x8001FC20"},
    {"owner": "0x8001F798", "pc": "0x8001FCD8"},
    {"owner": "0x8001F798", "pc": "0x8001FF64"},
    {"owner": "0x8001F798", "pc": "0x8001FFF8"},
    {"owner": "0x8001F798", "pc": "0x800201A8"},
    {"owner": "0x8001F798", "pc": "0x80020200"},
    {"owner": "0x8001F798", "pc": "0x8002023C"},
    {"owner": "0x8001F798", "pc": "0x800202C0"},
    {"owner": "0x8001F798", "pc": "0x8002031C"},
    {"owner": "0x8001F798", "pc": "0x80020430"},
    {"owner": "0x8001F798", "pc": "0x80020494"},
    {"owner": "0x8001F798", "pc": "0x8002051C"},
    {"owner": "0x8001F798", "pc": "0x80020578"},
    {"owner": "0x8001F798", "pc": "0x8002066C"},
    {"owner": "0x8001F798", "pc": "0x80020704"},
    {"owner": "0x8001F798", "pc": "0x8002074C"},
    {"owner": "0x8001F798", "pc": "0x80020860"},
    {"owner": "0x8001F798", "pc": "0x800208AC"}
  ],

  // ── overlays ──────────────────────────────────────────────────────────────────────────────────
  // Spyro's overlays are NOT separate disc files. They are byte ranges inside WAD.WAD streamed into
  // ONE shared staging ARENA at 0x8007AA38 — the read-only constant [0x800113A0] (claim C032), not a
  // per-overlay base. The arena is reloaded constantly (a single run does several swaps), so psxport's
  // slot router tells the residents apart by content signature rather than by address.
  //
  // THE SET IS NOT LISTED HERE, AND NOT BY HAND. Nothing in the executable enumerates the overlays —
  // the WAD offset arrives in a register at the call site — so the only authority is a RUN.
  // tools/overlay_scan.py reads the `cdq` log's arena loads and writes game/overlays.json (offset +
  // length exactly as the loader received them); tools/ensure_recomp.py slices those out of WAD.WAD.
  // Re-run it after any run that gets further and the set grows; it merges, never replaces.
  //
  // Consequently there are no per-overlay BASES to record and none to get wrong: an entry is in the
  // set BECAUSE its destination was the arena, so one pattern covers the whole set for good.
  //
  // WHY A RUN, AND NOT THE IMAGE. "Which overlay is resident" is a runtime fact, and the last overlay
  // the router IDENTIFIED is not necessarily the one live at a fail-fast — the arena gets reloaded
  // after it. Reading a missing address out of the previously-identified overlay's image showed
  // unrelated bytes and produced a confidently wrong diagnosis (issue 0025). The port now dumps guest
  // RAM at every miss (PSXPORT_MISS_RAMDUMP), which settles it: search WAD.WAD for the resident bytes.
  "overlay_bases": {},
  "overlay_base_patterns": [["OV_[0-9A-F]+", "0x8007AA38"]],
  // Function-pointer-only entries inside an overlay — invisible to `jal` discovery by construction.
  //
  // Per-overlay seeds that someone REASONED about. Empty, and that is the point: the one recurring
  // case — each level overlay's per-frame entry, installed into [0x80075734] and called indirectly at
  // 0x80033AA4 — is now DERIVED rather than hand-added. tools/overlay_scan.py reads main's own install
  // table (43 stores, 36 distinct addresses, matching the 36 code overlays of C033) and claims an
  // address for an overlay only when it is prologue-shaped in that overlay's OWN bytes; ensure_recomp.py
  // merges the result into generated/.recomp_seeds_merged.json, which is what emit.py consumes.
  //
  // Add here only a seed the derivation CANNOT produce, with the reasoning that justifies it. Do not
  // copy derived entries back in: they are regenerated every run, and mixing a generated list into a
  // file whose whole value is that every line was justified is how that value gets lost.
  "overlay_seeds": {}
}
